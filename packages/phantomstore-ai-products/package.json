{
  "name": "@phantomforce/phantomstore-ai-products",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./platform": {
      "types": "./types/platform.d.ts",
      "import": "./src/platform.mjs"
    },
    "./catalog": {
      "types": "./types/catalog.d.ts",
      "import": "./src/catalog.mjs"
    }
  },
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node src/server.mjs",
    "start": "node src/server.mjs",
    "migrate": "node src/migrate.mjs",
    "prioritize:milestone2": "node scripts/prioritize-milestone-2.mjs",
    "ledger:milestone2": "node scripts/update-milestone-2-ledger.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node --test tests/*.test.mjs && node scripts/verify-static.mjs"
  }
}
